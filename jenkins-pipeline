
pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code...'

                git branch: 'main',
                    url: 'https://github.com/YOUR-USERNAME/Jenkins-CD-Model-Questions.git'
            }
        }

        stage('Build') {
            steps {
                echo 'Building the application...'

                sh 'mvn clean compile'
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'

                sh 'mvn test'
            }
        }
    }

    post {

        success {
            mail to: 'YOUR-EMAIL@example.com',
                subject: "CD Pipeline - SUCCESS - Build #${env.BUILD_NUMBER}",
                body: "The pipeline ${env.JOB_NAME} completed successfully. Details: ${env.BUILD_URL}"
        }

        failure {
            mail to: 'YOUR-EMAIL@example.com',
                subject: "CD Pipeline - FAILURE - Build #${env.BUILD_NUMBER}",
                body: "The pipeline ${env.JOB_NAME} failed. Check the console: ${env.BUILD_URL}console"
        }
    }
}
